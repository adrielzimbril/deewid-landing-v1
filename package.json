  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.1",
    "live-server": "^1.1.0",
    "prettier": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.5.5",
    "tailwindcss": "^3.3.3"
  }
}
