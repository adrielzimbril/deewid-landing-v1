{
  "name": "tailwind",
  "version": "1.0.0",
  "description": "",
  "main": "tailwind.config.js",
  "scripts": {
    "start:server": "live-server --port=3000 --open=./index.html",
    "dev:css": "tailwindcss -i ./src/tailwind.css -o f/a/css/style.css --watch",
